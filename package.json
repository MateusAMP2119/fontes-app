{
  "name": "fontes",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:local": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "deploy": "npm run build && wrangler pages deploy",
    "setup:api": "git submodule update --init services/api && npm ci --prefix services/api",
    "build:api": "npm --prefix services/api run build",
    "test:api": "npm --prefix services/api test",
    "test:ui": "node --test scripts/auth-regression.test.mjs scripts/onboarding-browser.test.mjs",
    "dev:api": "npm --prefix services/api run dev"
  },
  "dependencies": {
    "better-auth": "1.7.2",
    "motion": "^12.43.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "oxlint": "^1.71.0",
    "playwright": "^1.61.1",
    "typescript": "~6.0.2",
    "vite": "^8.1.1",
    "wrangler": "^4.129.0"
  }
}
